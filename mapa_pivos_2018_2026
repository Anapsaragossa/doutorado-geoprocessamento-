        "# =============================================================================\n",
        "# mapa_instalacao_artigo.py — mapa do período de instalação, pronto para o artigo\n",
        "#\n",
        "# Script COMPLETO e independente: monta o Drive, acha os dados, confere a\n",
        "# contagem e desenha. Não precisa do bootstrap nem de ter rodado o §5, o §7 ou\n",
        "# o §8 nesta sessão. Para usar, suba o arquivo para a pasta do projeto e rode\n",
        "# numa célula:\n",
        "#\n",
        "#     exec(open('/content/drive/MyDrive/Tese_IA_Jussara/'\n",
        "#               'mapa_instalacao_artigo.py').read())\n",
        "#\n",
        "# ou cole o conteúdo inteiro numa célula e execute.\n",
        "#\n",
        "# --- O QUE ELE FAZ DE DIFERENTE ---------------------------------------------\n",
        "#\n",
        "# 1. A figura NASCE com a largura que vai ter na página (LARGURA_CM). O\n",
        "#    espacializar.py desenha grande e a publicação reduz seis vezes: texto\n",
        "#    pensado para 17 cm chega ao papel com 3 pt. Aqui, rótulo ilegível aparece\n",
        "#    na hora de gerar, não na prova.\n",
        "#\n",
        "# 2. A contagem sai da trajetória consolidada e é CONFERIDA contra a série.\n",
        "#    O mapa anterior trazia 262 pivôs e 129 na classe de 2018 — são os números\n",
        "#    da rodada antiga, de antes do teto de raio 904, da supressão dos parciais\n",
        "#    duplicados e da regra do isolado. Depois das correções a série dá 254 em\n",
        "#    2026. Se o total voltar a dar 262, o script avisa em voz alta.\n",
        "#\n",
        "# 3. Sem título e sem rodapé DENTRO da imagem: os dois pertencem à legenda da\n",
        "#    figura, onde saem em corpo de texto e se leem.\n",
        "# =============================================================================\n",
        "import os\n",
        "import re\n",
        "import glob\n",
        "import time\n",
        "import shutil\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import geopandas as gpd\n",
        "import matplotlib.pyplot as plt\n",
        "from matplotlib.patches import Patch\n",
        "\n",
        "# ---- o que dá para ajustar ---------------------------------------------------\n",
        "P = '/content/drive/MyDrive/Tese_IA_Jussara'\n",
        "TAG = 'jussara'\n",
        "EPSG_M = 31982                  # SIRGAS 2000 / UTM 22S\n",
        "LARGURA_CM = 5.7                # a largura da figura na página do artigo\n",
        "ANOS = list(range(2018, 2027))\n",
        "ARQUIVO = None                  # força um arquivo de trajetória, se quiser\n",
        "LIMITE = None                   # força o arquivo do limite municipal\n",
        "\n",
        "# As classes seguem as três fases do texto (§4.1): crescimento lento até 2020,\n",
        "# surto em 2021–2022, desaceleração de 2023 em diante. Antes, 2022 ficava junto\n",
        "# com 2023–2026, e os 34 pivôs do segundo ano do surto apareciam na fase errada.\n",
        "# Contagem esperada com a série consolidada atual: 126 / 13 / 92 / 25 = 256\n",
        "# (254 em 2026 mais as 2 identidades que saíram da série depois de 2023).\n",
        "CLASSES = [('2018 ou antes', lambda a: a <= 2018,         '#cfe2f3'),\n",
        "           ('2019–2020',     lambda a: 2019 <= a <= 2020, '#7fb3e0'),\n",
        "           ('2021–2022',     lambda a: 2021 <= a <= 2022, '#2a78d6'),\n",
        "           ('2023–2026',     lambda a: a >= 2023,         '#10325e')]\n",
        "ESPERADO = [126, 13, 92, 25]\n",
        "\n",
        "SAIDA = f'{P}/mapa_instalacao_artigo_{TAG}.png'\n",
        "TMP = '/content/_gpkg_tmp'\n",
        "\n",
        "\n",
        "# %% [M0] Drive e leitura de vetor --------------------------------------------\n",
        "def _drive():\n",
        "    try:\n",
        "        os.listdir('/content/drive/MyDrive')\n",
        "        return\n",
        "    except OSError:\n",
        "        pass\n",
        "    from google.colab import drive\n",
        "    try:\n",
        "        drive.flush_and_unmount()\n",
        "    except Exception:\n",
        "        pass\n",
        "    drive.mount('/content/drive', force_remount=True)\n",
        "    print('Drive remontado')\n",
        "\n",
        "\n",
        "def _ler(caminho, **kw):\n",
        "    \"\"\"GPKG é SQLite e corrompe lido pelo FUSE: copia para disco local antes.\"\"\"\n",
        "    if caminho.lower().endswith('.csv'):\n",
        "        return pd.read_csv(caminho, **kw)\n",
        "    os.makedirs(TMP, exist_ok=True)\n",
        "    local = f'{TMP}/{os.path.basename(caminho)}'\n",
        "    for t in range(1, 4):\n",
        "        try:\n",
        "            with open(caminho, 'rb') as f1, open(local, 'wb') as f2:\n",
        "                shutil.copyfileobj(f1, f2, length=4 * 1024 * 1024)\n",
        "            break\n",
        "        except OSError as e:\n",
        "            print(f'  cópia falhou (errno {e.errno}) — tentativa {t}')\n",
        "            _drive()\n",
        "            time.sleep(4)\n",
        "    return gpd.read_file(local, **kw)\n",
        "\n",
        "\n",
        "_drive()\n",
        "print(f'pasta do projeto: {len(os.listdir(P))} itens\\n')\n",
        "\n",
        "\n",
        "# %% [M1] Achar a trajetória consolidada ---------------------------------------\n",
        "CHAVES = ('primeira_aparicao', 'sequencia_cheia', 'sequencia')\n",
        "\n",
        "\n",
        "def _candidatos():\n",
        "    \"\"\"Vasculha a pasta e devolve o que tem cara de trajetória consolidada.\"\"\"\n",
        "    arqs = [a for a in glob.glob(f'{P}/*.gpkg') + glob.glob(f'{P}/*.csv')\n",
        "            if re.search(r'trajet|consolid|ident', os.path.basename(a), re.I)]\n",
        "    saida = []\n",
        "    for a in sorted(arqs):\n",
        "        try:\n",
        "            amostra = (pd.read_csv(a, nrows=3) if a.endswith('.csv')\n",
        "                       else _ler(a, rows=3))\n",
        "        except TypeError:\n",
        "            amostra = _ler(a)          # geopandas antigo não aceita rows=\n",
        "        except Exception as e:\n",
        "            print(f'  {os.path.basename(a)}: não abre ({type(e).__name__})')\n",
        "            continue\n",
        "        cols = list(amostra.columns)\n",
        "        if any(k in cols for k in CHAVES):\n",
        "            quando = time.strftime('%d/%m %H:%M',\n",
        "                                   time.localtime(os.path.getmtime(a)))\n",
        "            saida.append((a, cols, quando))\n",
        "            print(f'  candidato: {os.path.basename(a)}   (gravado em {quando})')\n",
        "    return saida\n",
        "\n",
        "\n",
        "print('procurando a trajetória consolidada:')\n",
        "if ARQUIVO:\n",
        "    alvo = ARQUIVO\n",
        "else:\n",
        "    cand = _candidatos()\n",
        "    if not cand:\n",
        "        raise FileNotFoundError(\n",
        "            'nenhum arquivo com coluna de sequência ou de primeira aparição em '\n",
        "            f'{P}.\\nRode o §8 (consolidar_serie.py) e tente de novo, ou aponte '\n",
        "            'o arquivo na constante ARQUIVO lá em cima.')\n",
        "    # o mais recente, que é o que saiu depois das correções\n",
        "    alvo = max((a for a, _, _ in cand), key=os.path.getmtime)\n",
        "\n",
        "t = _ler(alvo)\n",
        "print(f'\\nusando: {os.path.basename(alvo)}  —  {len(t)} identidades')\n",
        "\n",
        "# ano de primeira aparição: a coluna, se houver; senão, lido da sequência\n",
        "if 'primeira_aparicao' in t.columns:\n",
        "    ano1 = pd.to_numeric(t.primeira_aparicao, errors='coerce')\n",
        "else:\n",
        "    col = 'sequencia_cheia' if 'sequencia_cheia' in t.columns else 'sequencia'\n",
        "    ano1 = t[col].astype(str).map(\n",
        "        lambda s: ANOS[s.index('X')] if 'X' in s else np.nan)\n",
        "t = t.assign(ano1=ano1)\n",
        "\n",
        "if 'isolado' in t.columns:\n",
        "    n0 = len(t)\n",
        "    t = t[~t.isolado.astype(bool)]\n",
        "    if n0 != len(t):\n",
        "        print(f'  {n0 - len(t)} isoladas descartadas')\n",
        "t = t[t.ano1.notna()].copy()\n",
        "\n",
        "if not isinstance(t, gpd.GeoDataFrame) or t.geometry.isna().all():\n",
        "    raise TypeError(\n",
        "        f'{os.path.basename(alvo)} veio sem geometria. Aponte em ARQUIVO o '\n",
        "        'GeoPackage da trajetória, aquele com os círculos medianos.')\n",
        "t = t.to_crs(EPSG_M)\n",
        "\n",
        "\n",
        "# %% [M2] Conferência: a legenda tem de fechar com a série ---------------------\n",
        "print('\\nclasses do mapa:')\n",
        "soma = 0\n",
        "for rot, teste, _ in CLASSES:\n",
        "    n = int(t.ano1.map(teste).sum())\n",
        "    soma += n\n",
        "    print(f'  {rot:<14} {n:>4}')\n",
        "print(f'  {\"total\":<14} {soma:>4}')\n",
        "obtido = [int(t.ano1.map(teste).sum()) for _, teste, _ in CLASSES]\n",
        "if obtido != ESPERADO:\n",
        "    print(f'\\nATENÇÃO: classes deram {obtido}, e o texto da tese supõe '\n",
        "          f'{ESPERADO}. Se a série mudou, o §4.1 precisa mudar junto.')\n",
        "\n",
        "serie = None\n",
        "for a in sorted(glob.glob(f'{P}/*.csv'), key=os.path.getmtime, reverse=True):\n",
        "    try:\n",
        "        d = pd.read_csv(a, nrows=20)\n",
        "    except Exception:\n",
        "        continue\n",
        "    if 'ano' in d.columns and 'n_consolidado' in d.columns:\n",
        "        serie = d\n",
        "        print(f'\\nsérie lida de {os.path.basename(a)}')\n",
        "        break\n",
        "if serie is not None:\n",
        "    n26 = serie.loc[serie.ano == 2026, 'n_consolidado']\n",
        "    if len(n26):\n",
        "        n26 = int(n26.iloc[0])\n",
        "        print(f'  consolidado em 2026 : {n26}')\n",
        "        print(f'  total do mapa       : {soma}')\n",
        "        print(f'  diferença           : {soma - n26}  '\n",
        "              f'<- pivôs que sumiram antes de 2026')\n",
        "\n",
        "primeira = int(t.ano1.map(CLASSES[0][1]).sum())\n",
        "if soma == 262 or primeira == 129:\n",
        "    print('\\n' + '!' * 70)\n",
        "    print('ATENÇÃO: 262 no total ou 129 na classe de 2018 são os números da')\n",
        "    print('rodada ANTIGA, anterior às correções. Rode produzir_serie, serie_v3')\n",
        "    print('com 904/250/True e consolidar_serie nesta sessão antes do mapa.')\n",
        "    print('!' * 70)\n",
        "\n",
        "\n",
        "# %% [M3] A figura, já na largura da página ------------------------------------\n",
        "if LIMITE:\n",
        "    lim = _ler(LIMITE)\n",
        "else:\n",
        "    achados = (glob.glob(f'{P}/limite_{TAG}_ibge.gpkg')\n",
        "               or glob.glob(f'{P}/limite_{TAG}*.gpkg')\n",
        "               or glob.glob(f'{P}/*limite*.gpkg'))\n",
        "    if not achados:\n",
        "        raise FileNotFoundError(f'não achei o limite municipal em {P}')\n",
        "    lim = _ler(achados[0])\n",
        "    print(f'\\nlimite: {os.path.basename(achados[0])}')\n",
        "lim = lim.to_crs(EPSG_M)\n",
        "\n",
        "minx, miny, maxx, maxy = lim.total_bounds\n",
        "larg_pol = LARGURA_CM / 2.54\n",
        "alt_pol = larg_pol * (maxy - miny) / (maxx - minx)\n",
        "\n",
        "plt.rcParams.update({'font.family': 'sans-serif', 'font.size': 7})\n",
        "fig, ax = plt.subplots(figsize=(larg_pol, alt_pol * 1.02), dpi=400)\n",
        "\n",
        "lim.boundary.plot(ax=ax, color='#555', lw=0.45, zorder=2)\n",
        "for rot, teste, cor in CLASSES:\n",
        "    sel = t[t.ano1.map(teste)]\n",
        "    if len(sel):\n",
        "        ax.scatter(sel.geometry.centroid.x, sel.geometry.centroid.y,\n",
        "                   s=5.0, c=cor, edgecolors='white', linewidths=0.15,\n",
        "                   zorder=3)\n",
        "\n",
        "ax.legend(handles=[Patch(facecolor=c, edgecolor='none', label=r)\n",
        "                   for r, _, c in CLASSES],\n",
        "          loc='upper left', fontsize=6, frameon=False,\n",
        "          handlelength=1.0, handleheight=0.9, labelspacing=0.35,\n",
        "          borderpad=0.1, title='primeira detecção', title_fontsize=6)\n",
        "\n",
        "# barra de escala em metro: o EPSG_M é projetado, então não há fator de latitude\n",
        "x0 = minx + (maxx - minx) * 0.03\n",
        "y0 = miny + (maxy - miny) * 0.045\n",
        "ax.plot([x0, x0 + 5000], [y0, y0], color='#1a1a1a', lw=1.1, zorder=4)\n",
        "ax.text(x0 + 2500, y0 + (maxy - miny) * 0.012, '5 km', ha='center',\n",
        "        va='bottom', fontsize=5.5, color='#1a1a1a')\n",
        "\n",
        "# a seta aponta para CIMA: o xy é o alvo, o xytext é onde fica o 'N'\n",
        "ax.annotate('N', xy=(maxx - (maxx - minx) * 0.04,\n",
        "                     maxy - (maxy - miny) * 0.02),\n",
        "            xytext=(maxx - (maxx - minx) * 0.04,\n",
        "                    maxy - (maxy - miny) * 0.11),\n",
        "            ha='center', va='top', fontsize=6,\n",
        "            arrowprops=dict(arrowstyle='-|>', color='#1a1a1a', lw=0.7))\n",
        "\n",
        "ax.set_xlim(minx, maxx)\n",
        "ax.set_ylim(miny, maxy)\n",
        "ax.set_aspect('equal')\n",
        "ax.set_axis_off()\n",
        "fig.subplots_adjust(0, 0, 1, 1)\n",
        "fig.savefig(SAIDA, bbox_inches='tight', pad_inches=0.02, facecolor='white')\n",
        "plt.show()\n",
        "\n",
        "print(f'\\nSalvo: {os.path.basename(SAIDA)} — {LARGURA_CM} cm de largura, do '\n",
        "      f'jeito que entra na página.')\n",
        "print('Para baixar:')\n",
        "print(\"    from google.colab import files; \"\n",
        "      f\"files.download('{SAIDA}')\")"
      ]
    }
